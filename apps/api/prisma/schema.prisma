generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          UserRole
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tutor         Tutor?
  student       Student?
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

enum UserRole {
  ADMIN
  TUTOR
  STUDENT
  PARENT
}

model Tutor {
  id          String    @id @default(uuid())
  userId      String    @unique
  qualification String?
  bio         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches     Batch[]
  students    Student[]
  subjects    Subject[]
  notifications Notification[]
}

model Student {
  id          String    @id @default(uuid())
  tutorId     String
  userId      String    @unique
  parentName  String?
  parentPhone String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutor                 Tutor                  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  enrollments           Enrollment[]
  attendance            Attendance[]
  examResults           ExamResult[]
  notifications         Notification[]
  studentProgress       StudentProgress[]

  @@index([userId])
  @@index([tutorId])
}

model Batch {
  id          String    @id @default(uuid())
  tutorId     String
  name        String
  code        String    @unique
  academicYear String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      BatchStatus @default(PLANNED)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subjects    BatchSubject[]
  enrollments Enrollment[]
  classSessions ClassSession[]
  exams       Exam[]
  notifications Notification[]

  @@index([tutorId])
  @@index([status])
}

enum BatchStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Subject {
  id          String    @id @default(uuid())
  tutorId     String
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  batchSubjects BatchSubject[]
  chapters      Chapter[]
  exams         ExamSyllabus[]
  classSessions ClassSession[]
  tutor         Tutor       @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([name])
}

model BatchSubject {
  id          String    @id @default(uuid())
  batchId     String
  subjectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([batchId, subjectId])
  @@index([batchId])
  @@index([subjectId])
}

model Enrollment {
  id          String    @id @default(uuid())
  batchId     String
  studentId   String
  status      EnrollmentStatus @default(ACTIVE)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([batchId])
  @@index([studentId])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  DROPPED
}

model Chapter {
  id          String    @id @default(uuid())
  subjectId   String
  title       String
  description String?
  order       Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics      Topic[]
  examSyllabi ExamSyllabus[]

  @@unique([subjectId, order])
  @@index([subjectId])
}

model Topic {
  id          String    @id @default(uuid())
  chapterId   String
  title       String
  description String?
  order       Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress    StudentProgress[]
  classSessions ClassSession[]
  examSyllabi ExamSyllabus[]

  @@unique([chapterId, order])
  @@index([chapterId])
}

model ClassSession {
  id          String    @id @default(uuid())
  batchId     String
  subjectId   String?
  topicId     String?
  title       String?
  scheduledAt DateTime
  durationMin Int       @default(60)
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  recurrenceGroupId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject     Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic       Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attendance  Attendance[]

  @@index([batchId, scheduledAt])
  @@index([status])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Attendance {
  id             String    @id @default(uuid())
  classSessionId String
  studentId      String
  status         AttendanceStatus @default(PRESENT)
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId])
  @@index([classSessionId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Exam {
  id          String    @id @default(uuid())
  batchId     String
  title       String
  type        ExamType
  scheduledAt DateTime?
  durationMin Int       @default(60)
  totalMarks  Int       @default(100)
  passingMarks Int      @default(40)
  instructions String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  syllabus    ExamSyllabus[]
  results     ExamResult[]

  @@index([batchId, scheduledAt])
}

enum ExamType {
  QUIZ
  UNIT_TEST
  MID_TERM
  FINAL
  MOCK
}

model ExamSyllabus {
  id          String    @id @default(uuid())
  examId      String
  subjectId   String
  chapterId   String?
  topicId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter     Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic       Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([examId, subjectId, chapterId, topicId])
  @@index([examId])
  @@index([subjectId])
  @@index([topicId])
}

model ExamResult {
  id          String    @id @default(uuid())
  examId      String
  studentId   String
  marksObtained Float?
  grade       String?
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model StudentProgress {
  id          String    @id @default(uuid())
  studentId   String
  topicId     String
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentId, topicId])
  @@index([studentId])
  @@index([status])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Notification {
  id          String    @id @default(uuid())
  userId      String?
  tutorId     String?
  batchId     String?
  studentId   String?
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutor       Tutor?    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  batch       Batch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tutorId])
  @@index([batchId])
  @@index([studentId])
  @@index([isRead])
}

enum NotificationType {
  INFO
  ATTENDANCE
  EXAM
  PAYMENT
  SYSTEM
}
